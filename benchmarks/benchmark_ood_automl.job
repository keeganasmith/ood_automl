#!/bin/bash
#SBATCH --job-name=benchmark_ood_automl
#SBATCH --time=24:0:00 --mem=300G
#SBATCH --ntasks=192 --nodes=1 --cpus-per-task=1
#SBATCH --output=out --error=error
#SBATCH --partition=cpu 


module purge
cd /scratch/user/u.ks124812/ood_automl/
# ADD YOUR COMMANDS BELOW
source modules.sh
cd backend
source venv/bin/activate

python3 app.py > output.txt 2>&1 &

health_url="http://localhost:8000/healthz"
max_wait_seconds=300
poll_interval_seconds=5
start_time=$(date +%s)

while true; do
  if curl -fsS "${health_url}" > /dev/null; then
    echo "Health check succeeded at ${health_url}"
    break
  fi

  elapsed_seconds=$(( $(date +%s) - start_time ))
  if [ "${elapsed_seconds}" -ge "${max_wait_seconds}" ]; then
    echo "ERROR: Server at ${health_url} did not become ready within ${max_wait_seconds}s." >&2
    exit 1
  fi

  sleep "${poll_interval_seconds}"
done

cd ..
for((i=0;i<40;i++)){
  python3 benchmarks/benchmark_web_ui.py
}
