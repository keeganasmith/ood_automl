#!/bin/bash
#SBATCH --job-name=benchmark_ood_automl
#SBATCH --time=24:0:00 --mem=300G
#SBATCH --ntasks=192 --nodes=1 --cpus-per-task=1
#SBATCH --output=out --error=error
#SBATCH --partition=cpu 
#SBATCH --exclusive


module purge
cd $SCRATCH/ood_automl/
# ADD YOUR COMMANDS BELOW
source modules.sh
cd backend
source venv/bin/activate
cd ..
python3 backend/app.py > output.txt 2>&1 &

sleep 5m #more than enough time for app.py to start
for((i=0;i<40;i++)){
  python3 benchmarks/benchmark_web_ui.py
}

